# Enforce LF line endings across all platforms (prevents CRLF / ^M errors on Linux and Docker)
* text=auto eol=lf

# Shell scripts and Docker files MUST use LF
*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf

# Code, configuration, and documentation
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ini text eol=lf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.parquet binary
*.pyc binary
